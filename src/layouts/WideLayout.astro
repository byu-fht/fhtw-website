---
import "@fontsource/gothic-a1/400.css";
import "../assets/base.css";
import NavBar from "../menu/NavBar.astro";

// Page title and description come from the page's frontmatter (title,
// description), or are derived for archive pages.
const SITE = "Family History Technology Workshop";
const { frontmatter = {} } = Astro.props;
const year = Astro.url.pathname.match(/^\/archive\/(\d{4})/)?.[1];
const pageTitle = frontmatter.title ?? (year && `${year} Program`);
const title = pageTitle ? `${pageTitle} | ${SITE}` : SITE;
const description =
  frontmatter.description ??
  (year
    ? `Program, papers, abstracts and slides from the ${year} Family History Technology Workshop at Brigham Young University.`
    : "The Family History Technology Workshop at Brigham Young University brings together researchers, developers and professionals working on technology that makes family history better.");
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/images/og-image.png", Astro.site);

const items = [
  {
    title: "Home",
    url: "/",
  },
  {
    title: "Call for Papers",
    url: "/call-for-papers",
  },
  {
    title: "Local Information",
    url: "/local-information",
  },
  {
    title: "Program",
    url: "/program",
  },
  {
    title: "Registration",
    url: "/registration",
  },
  {
    title: "Archive",
    submenu: [
      {
        title: "2026",
        url: "/archive/2026",
      },
      {
        title: "2025",
        url: "/archive/2025",
      },
      {
        title: "2024",
        url: "/archive/2024",
      },
      {
        title: "2023",
        url: "/archive/2023",
      },
      {
        title: "2020",
        url: "/archive/2020",
      },
      {
        title: "2019",
        url: "/archive/2019",
      },
      {
        title: "2018",
        url: "/archive/2018",
      },
      {
        title: "2017",
        url: "/archive/2017",
      },
      {
        title: "2016",
        url: "/archive/2016",
      },
      {
        title: "2015",
        url: "/archive/2015",
      },
      {
        title: "2014",
        url: "/archive/2014",
      },
      {
        title: "2013",
        url: "/archive/2013",
      },
      {
        title: "2012",
        url: "/archive/2012",
      },
      {
        title: "2011",
        url: "/archive/2011",
      },
      {
        title: "2010",
        url: "/archive/2010",
      },
      {
        title: "2009",
        url: "/archive/2009",
      },
      {
        title: "2008",
        url: "/archive/2008",
      },
      {
        title: "2007",
        url: "/archive/2007",
      },
      {
        title: "2006",
        url: "/archive/2006",
      },
      {
        title: "2005",
        url: "/archive/2005",
      },
      {
        title: "2004",
        url: "/archive/2004",
      },
      {
        title: "2003",
        url: "/archive/2003",
      },
      {
        title: "2002",
        url: "/archive/2002",
      },
      {
        title: "2001",
        url: "/archive/2001",
      },
    ],
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Link previews (Slack, email, social media) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE} />
    <meta property="og:title" content={pageTitle ?? SITE} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Family History Technology Workshop logo" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>

  <body class="mx-0">
    <header>
      <NavBar prefix="" items={items} />
    </header>

    <slot />

    <footer>
      <div
        class="text-default text-sm flex justify-center px-5 py-3 lg:px-[75px] md:ml-auto md:mr-auto max-w-5xl"
      >
        <div>
          <p>
            Papers and presentations are copyright by their authors. You may
            print or copy them for personal, non-commercial use. For all other
            uses, please contact the authors.
          </p>

          <p>
            All other web site materials released via <a
              rel="license"
              href="http://creativecommons.org/licenses/by-sa/3.0/deed.en_US"
              ><img
                alt="Creative Commons License"
                style="border-width:0"
                src="/images/cc-by-sa.png"
              /></a
            >
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>
